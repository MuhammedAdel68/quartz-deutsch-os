{
  "compilerOptions": {
    "lib": ["esnext", "DOM", "DOM.Iterable"],
    "experimentalDecorators": true,
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "incremental": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": ["quartz/**/*.ts", "quartz/**/*.tsx", "*.ts", "*.tsx", "./package.json"],
  "exclude": [
    "build/**/*.d.ts",
    ".quartz/**/src/**",
    ".quartz/**/test/**",
    "node_modules/**",
    "quartz/cli/tui/**",
    "quartz/components/AcousticAnalytics.tsx",
    "quartz/components/PronunciationHelper.tsx",
    "quartz/components/SemanticSearch.tsx",
    "quartz/components/SpacedRepetition.tsx",
    "quartz/components/WebAgentContext.tsx",
    "quartz/components/YouTubeSync.tsx",
    "quartz/components/scripts/embeddingWorker.ts",
    "quartz/components/scripts/semanticSearch.inline.ts"
  ]
}
